# Copy this file to .env and fill in your values.
# .env is gitignored — never commit actual keys.

# Claude API — only used in decider.py for tone/channel/escalation decisions
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Razorpay test-mode credentials — get these from the Razorpay dashboard under Settings > API Keys
# Make sure you're on the TEST tab, not Live
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here

# Optional — set to "true" to print raw SQL to the terminal while debugging
DEBUG=false

# Stopping rules — these are the compliance policy defaults.
# Change them here rather than hardcoding in stopper.py.
MAX_RETRY_ATTEMPTS=3
